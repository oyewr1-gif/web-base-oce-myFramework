# ========================================================
# PENGATURAN REST API (api-info)
# ========================================================
API_NAME="CMS Info REST API"
API_VERSION="1.0.0"
API_CORS_ORIGIN="*"

# ========================================================
# KONEKSI DATABASE KHUSUS REST API (Opsional jika ingin terpisah)
# ========================================================
API_DB_DRIVER=mysql
API_DB_HOST=localhost
API_DB_PORT=3306
API_DB_DATABASE=cms_framework
API_DB_USERNAME=your_db_username
API_DB_PASSWORD=your_db_password
API_DB_CHARSET=utf8mb4
