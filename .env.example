# ========================================================
# PENGATURAN APLIKASI UTAMA CMS
# ========================================================
APP_NAME="Modern PHP MVC CMS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/myFramework

# ========================================================
# KONEKSI REST API (api-info) UNTUK FRONT-END
# ========================================================
# Biarkan kosong untuk auto-detect otomatis, atau arahkan ke
# domain server terisolasi (misal: https://api.domain.com)
API_BASE_URL=

# ========================================================
# KONEKSI DATABASE UTAMA (MySQL / MariaDB)
# ========================================================
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cms_framework
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_CHARSET=utf8mb4

# ========================================================
# PENGATURAN KEAMANAN & SESI
# ========================================================
SESSION_LIFETIME=7200
TIMEZONE=Asia/Jakarta
